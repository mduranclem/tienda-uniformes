DATABASE_URL="postgresql://usuario:password@db.xxxx.supabase.co:5432/postgres"
PORT=3001
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_JWT_SECRET=your-jwt-secret
# Settings → API → Project API keys → "service_role" (secret). NUNCA la anon key,
# y NUNCA se expone al frontend — solo la usa el backend para subir a Storage.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
NODE_ENV=development

# Mercado Pago
MP_ACCESS_TOKEN=TEST-xxx...          # sandbox: TEST-xxx | producción: APP_USR-xxx
MP_WEBHOOK_SECRET=                   # secret del webhook en dashboard MP
API_URL=https://api.tiendadeuniformes.store

# Notificaciones admin vía n8n (dejar vacío para deshabilitar)
N8N_WEBHOOK_PEDIDO=

# Bot de WhatsApp (n8n) — ver bot/SYSTEM_PROMPT.md
BOT_API_KEY=                         # header x-bot-key que debe mandar n8n
WEBHOOK_STOCK_ALERT=                 # también editable desde /admin/bot (tiene prioridad)
WEBHOOK_ORDEN_PAGADA=
WEBHOOK_ORDEN_ESTADO=
